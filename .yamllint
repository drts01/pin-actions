extends: default
ignore-from-file: .gitignore
strict: true
rules:
  anchors:
    forbid-duplicated-anchors: true
    forbid-unused-anchors: true
  braces:
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 2
  brackets:
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 2
  comments:
    ignore:
      - .github/workflows/*
  document-end:
    present: false
  document-start:
    present: false
  empty-values: enable
  float-values:
    require-numeral-before-decimal: true
    forbid-scientific-notation: true
    forbid-nan: true
    forbid-inf: true
  indentation:
    spaces: 2
  line-length:
    max: 120
    allow-non-breakable-inline-mappings: true
  octal-values: enable
  quoted-strings:
    quote-type: single
    required: only-when-needed
    allow-quoted-quotes: true
    check-keys: true
  truthy:
    ignore:
      - .github/workflows/*
